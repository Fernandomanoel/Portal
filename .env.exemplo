# Copie para .env (que NÃO vai para o repositório). O ./instalar-vps.sh faz isso e gera as chaves sozinho.
# Cada valor numa linha só, sem aspas em volta. Gere os hashes das senhas como em docs/SERVIDOR.md.

# Endereço do portal. Com domínio próprio: portal.suaescola.com.br (aponte o registro A para o IP do servidor).
# Sem domínio: use IP-COM-HIFENS.sslip.io, por exemplo 203-0-113-10.sslip.io (HTTPS funciona do mesmo jeito).
DOMINIO=portal.exemplo.com.br

# 32 caracteres ou mais, aleatórios (assina o login).
SEGREDO_SESSAO=troque-por-um-texto-aleatorio-de-32-caracteres-ou-mais

UNIDADES=[{"id":"centro","nome":"Centro","senha":"scrypt:...","lembrete":"senha-da-prova"}]
PROFESSORES=[{"usuario":"manoel","nome":"Manoel","administrador":true,"unidade":"*","senha":"scrypt:..."}]

# Unidade que herda envios e listas antigos (opcional).
UNIDADE_PADRAO=centro

# WhatsApp (Evolution API): a chave e a senha do banco ficam só no servidor.
EVOLUTION_API_KEY=troque-por-uma-chave-longa
EVOLUTION_DB_SENHA=troque-por-uma-senha
