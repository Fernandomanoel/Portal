# Copie para .env (que NÃO vai para o repositório) e preencha. Cada valor numa linha só, sem aspas em volta.
# Gere os hashes com: npm run professor:senha  e  npm run unidade:senha  (docs/SERVIDOR.md).

# Obrigatória: 32 caracteres ou mais, aleatórios (assina o login).
SEGREDO_SESSAO=troque-por-um-texto-aleatorio-de-32-caracteres-ou-mais

UNIDADES=[{"id":"centro","nome":"Centro","senha":"scrypt:...","lembrete":"senha-da-prova"}]
PROFESSORES=[{"usuario":"manoel","nome":"Manoel","administrador":true,"unidade":"*","senha":"scrypt:..."}]

# Unidade que herda envios e listas antigos (opcional).
UNIDADE_PADRAO=centro

# Porta do portal no computador (padrão 8080).
#PORTA_DO_PORTAL=8080

# Só para o envio automático de WhatsApp (docker-compose.whatsapp.yml):
#EVOLUTION_API_KEY=troque-por-uma-chave-longa
#EVOLUTION_DB_SENHA=troque-por-uma-senha
