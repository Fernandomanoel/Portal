{
  "name": "portal-atividades",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gerar-registro-provas.mjs && node scripts/gerar-registro-aulas.mjs && vite",
    "build": "node scripts/gerar-registro-provas.mjs && node scripts/gerar-registro-aulas.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ilustracoes": "node scripts/ilustracoes/gerar.mjs",
    "build:servidor": "rolldown servidor/local.ts --platform node --format esm --no-codeSplitting --file dist-servidor/servidor.mjs",
    "servidor": "node dist-servidor/servidor.mjs",
    "professor:senha": "node scripts/senha-professor.mjs",
    "unidade:senha": "node scripts/senha-unidade.mjs",
    "curso-ingles:senha": "node scripts/senha-curso-ingles.mjs",
    "provas-ingles:senha": "node scripts/senha-provas-ingles.mjs",
    "prints:contabilidade": "python3 scripts/planilhas/prints_contabilidade.py \"$(node scripts/planilhas/exportar.mjs)\"",
    "planilhas": "python3 scripts/planilhas/gerar.py \"$(node scripts/planilhas/exportar.mjs)\""
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "rolldown": "^1.2.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
